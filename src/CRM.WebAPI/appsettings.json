{
  "Serilog": {
    "Using": ["Serilog.Sinks.Console"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "Database": {
    "ConnectionString": "Server=(localdb)\\MSSQLLocalDB;Database=CRM_DB;Trusted_Connection=true;TrustServerCertificate=true;"
  },
  "Jwt": {
    "SecretKey": "CHANGE_THIS_TO_A_SECURE_KEY_OF_AT_LEAST_32_CHARACTERS_LONG!!",
    "Issuer": "CRM.WebAPI",
    "Audience": "CRM.Angular",
    "ExpirationMinutes": 60
  },
  "AllowedHosts": "*"
}
